/target
**/node_modules
/ui/dist
# The built UI is embedded into the binary at compile time; keep the placeholder
# so `rust-embed` always has a folder to read.
/crates/ferrum-web/ui-dist/*
!/crates/ferrum-web/ui-dist/index.html
*.db
*.db-wal
*.db-shm
.DS_Store
.env
/tests/.tmp
.claude/
# `minisign -G` writes the release signing key beside the public key it also
# writes, so the secret half lands in the clone by default. It belongs in a
# password manager and in the MINISIGN_SECRET_KEY repository secret, nowhere
# else (docs/releasing.md).
minisign.key
