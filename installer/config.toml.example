# Unihelm panel configuration.
#
# This file holds only what is needed to reach the database; everything else is
# a setting in the panel, so changing it is an audited action rather than an SSH
# session (spec §4.3). Unknown keys are rejected at startup, so a typo here is a
# clear error and not a silently ignored line.

[panel]
# Where the panel listens. All interfaces, so the panel is reachable at
# https://<this server's address>:8088 as soon as the installer finishes —
# needing a domain or an ssh tunnel before you can even see it is not a decision
# to make for you. Set this to 127.0.0.1:8088 if you would rather it were not.
listen = "0.0.0.0:8088"
database = "/var/lib/unihelm/panel.db"
state_dir = "/var/lib/unihelm/state"
cli_socket = "/run/unihelm/web.sock"

# How the panel serves itself.
#
#   self-signed  Generate a certificate on first start and serve HTTPS. The
#                browser warns once, because the certificate vouches for nobody
#                — but the password and the session are encrypted, which on a
#                public address is the part that matters.
#   off          Plain HTTP. Correct only behind a proxy that terminates TLS and
#                sets X-Forwarded-Proto, which is what `unihelm cert panel
#                <domain>` sets up — and it turns this off for you. On its own it
#                means passwords cross the network in the clear.
tls = "self-signed"

# Send session cookies with the Secure attribute. Leave this on. With it off a
# session cookie can cross an unencrypted hop; it exists for plain-HTTP
# development, not as a way to make an exposed panel log you in.
secure_cookies = true

[agent]
socket = "/run/unihelm/agent.sock"
# The unprivileged account unihelm-web runs as. The agent resolves this to a uid
# at startup and refuses connections from any other account.
web_user = "unihelm"
# Task workers, plus one dedicated fast lane for service actions.
workers = 2

[log]
# `error`, `warn`, `info`, `debug`, `trace`, or a full RUST_LOG filter such as
# "info,unihelm_ops=debug".
level = "info"
# `json` for journald and log shipping, `text` when reading by eye.
format = "json"
