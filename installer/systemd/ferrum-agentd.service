[Unit]
Description=Ferrum privileged agent
Documentation=https://github.com/farzam/ferrum
After=network-online.target
Wants=network-online.target
# The agent must be up before the web process tries to reach it, but the web
# process starting first is survivable — it reconnects.
Before=ferrum-web.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/ferrum/bin/ferrum-agentd --config /etc/ferrum/config.toml

# The panel must never be the reason a site is down (spec §2.1). Restart
# unconditionally, quickly, and let the watchdog catch a wedge that is not a
# crash.
Restart=always
RestartSec=2
WatchdogSec=30

# Never a candidate for the OOM killer before the workloads it manages: if the
# server is under memory pressure, the thing that can fix it must survive.
OOMScoreAdjust=-500

# Rate limiting exists to stop a crash loop from hiding a real problem, not to
# give up on restarting.
StartLimitIntervalSec=300
StartLimitBurst=10

# The agent owns the shared runtime directory. `ferrum-web` only needs to
# traverse it to reach the socket, so it must not declare it too — two units
# declaring the same RuntimeDirectory fight over its ownership.
RuntimeDirectory=ferrum
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
LogsDirectory=ferrum

# This process is root by design (spec §5.1), so the hardening here is about
# reducing what "root" reaches, not pretending it is unprivileged.
NoNewPrivileges=no
ProtectHome=read-only
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ferrum-agentd

[Install]
WantedBy=multi-user.target
