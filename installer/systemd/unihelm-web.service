[Unit]
Description=Unihelm panel web server
Documentation=https://github.com/farzam-seyedhashem/unihelm
After=network-online.target unihelm-agentd.service
# `After=` alone only orders the two when both are already being started, so
# `systemctl start unihelm-web` on its own would start the web process against a
# database no agent has created — and unihelm-web does not migrate. `Wants=`
# pulls the agent in; `Requires=` would also stop web whenever the agent stops,
# which this unit deliberately survives.
Wants=network-online.target unihelm-agentd.service

[Service]
Type=notify
NotifyAccess=main
User=unihelm
Group=unihelm
ExecStart=/usr/local/unihelm/bin/unihelm-web --config /etc/unihelm/config.toml

Restart=always
RestartSec=2
WatchdogSec=30
StartLimitIntervalSec=300
StartLimitBurst=10

LogsDirectory=unihelm

# This process is internet-facing and holds no privileges, so it gets the full
# treatment (spec §5.5). Anything it needs, it asks the agent for.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Drop every capability: it needs none, and saying so makes that checkable.
CapabilityBoundingSet=
AmbientCapabilities=

# The only writable paths. `/run/unihelm` is created by the agent, so it is
# marked optional (`-`) rather than making web fail to start when the agent has
# not come up yet.
ReadWritePaths=/var/lib/unihelm /var/log/unihelm
ReadWritePaths=-/run/unihelm

StandardOutput=journal
StandardError=journal
SyslogIdentifier=unihelm-web

[Install]
WantedBy=multi-user.target
