[Unit]
Description=Unihelm privileged agent
Documentation=https://github.com/farzam-seyedhashem/unihelm
After=network-online.target
Wants=network-online.target
# The agent must be up before the web process tries to reach it, but the web
# process starting first is survivable — it reconnects.
Before=unihelm-web.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/unihelm/bin/unihelm-agentd --config /etc/unihelm/config.toml

# The panel must never be the reason a site is down (spec §2.1). Restart
# unconditionally, quickly, and let the watchdog catch a wedge that is not a
# crash.
Restart=always
RestartSec=2
WatchdogSec=30

# Never a candidate for the OOM killer before the workloads it manages: if the
# server is under memory pressure, the thing that can fix it must survive.
OOMScoreAdjust=-500

# Rate limiting exists to stop a crash loop from hiding a real problem, not to
# give up on restarting.
StartLimitIntervalSec=300
StartLimitBurst=10

# The agent owns the shared runtime directory. `unihelm-web` only needs to
# traverse it to reach the socket, so it must not declare it too — two units
# declaring the same RuntimeDirectory fight over its ownership.
RuntimeDirectory=unihelm
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
LogsDirectory=unihelm

# This process is root by design (spec §5.1), so the hardening here is about
# reducing what "root" reaches, not pretending it is unprivileged.
NoNewPrivileges=no

# ProtectHome is deliberately NOT set. Creating a tenant's home directory is
# this daemon's job — `ProtectHome=read-only` makes `useradd --create-home` fail
# with a bare "cannot create directory", which is a hardening setting silently
# breaking the feature it was supposed to protect. `unihelm-web`, which must never
# see a tenant's files, sets ProtectHome=yes instead; that is where the setting
# belongs.
ProtectHome=no
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=unihelm-agentd

[Install]
WantedBy=multi-user.target
