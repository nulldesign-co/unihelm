{# `http2 on;` exists only from nginx 1.25.1. Before that HTTP/2 was a listen
   parameter, and the directive is a hard `unknown directive` that fails
   `nginx -t` — Ubuntu 24.04 ships 1.24.0, so every vhost rendered here was
   invalid on a distribution this project supports and tests on. #}
# The panel's own vhost.
#
# `unihelm-web` terminates its own TLS, so a server with no domain is still
# reachable and still safe to type a password into. Once a domain exists, nginx
# fronts it on 443 with a real certificate and proxies to the panel over
# loopback. That means the panel gets the same certificate handling, the same
# HTTP/2, and the same security headers as every site — and the web process
# keeps its tiny attack surface.

server {
    listen 80;
    listen [::]:80;
    server_name {{ panel_domain }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl{% if not http2_on %} http2{% endif %};
    listen [::]:443 ssl{% if not http2_on %} http2{% endif %};
{% if http2_on %}
    http2 on;
{% endif %}
    server_name {{ panel_domain }};

    ssl_certificate     {{ cert_path }};
    ssl_certificate_key {{ key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    # The panel is never framed and never embedded, so the policy can be as
    # tight as it gets.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Chunked uploads in the file manager need headroom; the API itself is
    # capped far lower inside unihelm-web.
    client_max_body_size {{ max_body_size }};

    location / {
        proxy_pass {{ upstream_scheme }}://{{ upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Server-sent events: buffering here would make the task drawer look frozen.
    location /api/events {
        proxy_pass {{ upstream_scheme }}://{{ upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        chunked_transfer_encoding off;
    }
}
