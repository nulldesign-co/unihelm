# {{ site.domain }} — {{ site.site_type }}
#
# Generated by Unihelm. Per-site escape hatches (custom snippet, PHP overrides,
# body size) are fields in the panel and are rendered into this file, so there is
# normally no reason to edit it by hand. If you do, the panel notices and shows
# you the diff instead of silently overwriting your work.

{% if site.rate_limit_enabled %}
# Per-site request limiting. The zone is keyed on the client address and named
# after the site so two sites cannot share (or exhaust) each other's budget.
limit_req_zone $binary_remote_addr zone={{ site.zone_name }}:10m rate={{ site.rate_limit_rps }}r/s;
limit_conn_zone $binary_remote_addr zone={{ site.zone_name }}_conn:10m;
{% endif %}

{% if site.tls_enabled and site.force_https %}
# Plain HTTP exists only to redirect and to answer ACME challenges.
server {
    listen 80;
    listen [::]:80;
    server_name {{ site.server_names }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

server {
{% if site.tls_enabled %}
    listen 443 ssl;
    listen [::]:443 ssl;
{% if site.http3 %}
    # No `reuseport` here: it may appear exactly once per address in the whole
    # configuration, and the catch-all server owns it.
    listen 443 quic;
    listen [::]:443 quic;
{% endif %}
    http2 on;

    ssl_certificate     {{ site.cert_path }};
    ssl_certificate_key {{ site.key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL_{{ site.zone_name }}:2m;
    ssl_session_timeout 1h;
    # Session tickets off: without key rotation they undermine forward secrecy,
    # and rotating them across a reload is not something a panel should get
    # subtly wrong.
    ssl_session_tickets off;
{% if site.ocsp_stapling %}
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate {{ site.chain_path }};
{% endif %}
{% if not site.force_https %}
    # TLS is available but not required, so plain HTTP still serves the site
    # rather than only redirecting.
    listen 80;
    listen [::]:80;
{% endif %}
{% else %}
    listen 80;
    listen [::]:80;
{% endif %}

    server_name {{ site.server_names }};
    root {{ site.document_root }};
    index index.php index.html index.htm;

    access_log {{ site.access_log }} combined;
    error_log  {{ site.error_log }} warn;

    client_max_body_size {{ site.client_max_body_size }};
{% if site.http3 and site.tls_enabled %}
    # Tell clients HTTP/3 is available; without this nobody ever tries it.
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
{% endif %}

    # Security headers. `always` so they are present on error responses too,
    # which is where they are most often missed.
{% for header in site.security_headers %}
    add_header {{ header }} always;
{% endfor %}

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml+rss application/atom+xml image/svg+xml font/ttf font/otf;

{% if site.rate_limit_enabled %}
    limit_req zone={{ site.zone_name }} burst={{ site.rate_limit_burst }} nodelay;
    limit_conn {{ site.zone_name }}_conn {{ site.conn_limit }};
{% endif %}

    # ACME first, and outside maintenance mode: a certificate must be renewable
    # even while the site is showing a maintenance page.
    location ^~ /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

{% if site.maintenance_mode %}
    # Maintenance mode. Everything below is still configured so that turning it
    # off is a reload, not a re-render.
    location / {
        return 503;
    }
    error_page 503 @maintenance;
    location @maintenance {
        root {{ maintenance_root }};
        rewrite ^ /maintenance.html break;
        internal;
    }
{% else %}
{% if site.site_type == "redirect" %}
    location / {
        return {{ site.redirect_code }} {{ site.redirect_target }}$request_uri;
    }
{% elif site.site_type == "proxy" %}
    location / {
        proxy_pass http://127.0.0.1:{{ site.proxy_port }};
        proxy_http_version 1.1;
        # Websockets work without a separate location block this way.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout {{ site.proxy_timeout }};
        proxy_buffering off;
    }
{% elif site.site_type == "php" %}
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        # The single most important line in this file. Without it, a request for
        # /uploads/avatar.png/evil.php is handed to PHP with PATH_INFO set, and
        # an upload directory becomes remote code execution.
        try_files $uri =404;

        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:{{ site.fpm_socket }};
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_read_timeout {{ site.php_timeout }};
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 64k;
    }
{% else %}
    location / {
        try_files $uri $uri/ =404;
    }
{% endif %}
{% endif %}

    # Static assets get a long cache; the site's own HTML does not.
    location ~* \.(?:jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|css|js|mp4|webm)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Dotfiles, version control and editor leftovers. `.well-known` is excluded
    # because ACME and security.txt live there.
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Files that are commonly left in a webroot and should never be served.
    location ~* \.(?:sql|bak|old|orig|save|swp|log|env|ini|conf|sh|yml|yaml|lock)$ {
        deny all;
        access_log off;
    }

{% if site.custom_snippet %}
    # --- custom snippet, from the panel -------------------------------------
    # Validated by `nginx -t` before this file was activated. If it is wrong,
    # the change was rejected and the previous configuration is still live.
{{ site.custom_snippet }}
    # --- end custom snippet ---------------------------------------------------
{% endif %}
}
