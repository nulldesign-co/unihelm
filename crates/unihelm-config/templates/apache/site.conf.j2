{# The Apache counterpart of `nginx/site.conf.j2`. Read them side by side: this
   file has to mean the same thing, and the two places it cannot are named in
   `docs/design/web-servers.md` and refused by `webserver::gaps` before a switch
   rather than dropped quietly here.

   Needs: mod_ssl, mod_proxy_fcgi, mod_rewrite, mod_headers, mod_expires,
   mod_deflate. `webserver::ApacheModules` asserts each is enabled before this
   is ever written, because a missing module is not a syntax error — Apache
   starts happily and simply stops doing the thing. #}
# {{ site.domain }} — {{ site.site_type }}
#
# Generated by Unihelm. Per-site escape hatches (PHP overrides, body size) are
# fields in the panel and are rendered into this file, so there is normally no
# reason to edit it by hand. If you do, the panel notices and shows you the diff
# instead of silently overwriting your work.

{% if site.tls_enabled and site.force_https %}
# Plain HTTP exists only to redirect and to answer ACME challenges.
<VirtualHost *:80>
    ServerName {{ site.domain }}
{% for alias in site.aliases %}
    ServerAlias {{ alias }}
{% endfor %}

    # Before the redirect, and outside it: a certificate must be renewable even
    # while every other path on the site is a 301.
    Alias /.well-known/acme-challenge/ {{ acme_webroot }}/.well-known/acme-challenge/
    <Directory "{{ acme_webroot }}/.well-known/acme-challenge">
        Require all granted
        Options -Indexes
        ForceType text/plain
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>
{% endif %}

<VirtualHost *:{% if site.tls_enabled %}443{% else %}80{% endif %}>
    ServerName {{ site.domain }}
{% for alias in site.aliases %}
    ServerAlias {{ alias }}
{% endfor %}

    DocumentRoot {{ site.document_root }}
    DirectoryIndex index.php index.html index.htm

    CustomLog {{ site.access_log }} combined
    ErrorLog {{ site.error_log }}
    LogLevel warn

    # nginx spells this {{ site.client_max_body_size }}; Apache takes bytes.
    LimitRequestBody {{ site.max_body_bytes }}

{% if site.tls_enabled %}
    SSLEngine on
    SSLCertificateFile    {{ site.cert_path }}
    SSLCertificateKeyFile {{ site.key_path }}
    # `-all` first, so this is the whole list and not an addition to whatever
    # the distribution's defaults happen to be.
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off
{% if site.ocsp_stapling %}
    SSLUseStapling on
    SSLCertificateChainFile {{ site.chain_path }}
{% endif %}
    # HTTP/2 where the module is loaded; Apache ignores a protocol it cannot
    # speak rather than refusing to start, so this is safe on a server without
    # mod_http2 and simply does nothing there.
    Protocols h2 http/1.1
{% endif %}

    # Security headers. `always` so they are present on error responses too,
    # which is where they are most often missed.
    #
    # The payload is rendered verbatim, exactly as the nginx template renders it
    # after `add_header`: both servers take `Name Value` there, and the one
    # header whose value needs quoting carries its own. Rebuilding the quoting
    # here would put two spellings of the same header in the project.
{% for header in site.security_headers %}
    Header always set {{ header }}
{% endfor %}

    AddOutputFilterByType DEFLATE text/plain text/css text/xml application/json
    AddOutputFilterByType DEFLATE application/javascript application/xml+rss
    AddOutputFilterByType DEFLATE application/atom+xml image/svg+xml font/ttf font/otf

    # ACME first, and outside maintenance mode, for the same reason as above.
    Alias /.well-known/acme-challenge/ {{ acme_webroot }}/.well-known/acme-challenge/
    <Directory "{{ acme_webroot }}/.well-known/acme-challenge">
        Require all granted
        Options -Indexes
        ForceType text/plain
    </Directory>

{% if site.maintenance_mode %}
    # Maintenance mode. Everything below is still configured so that turning it
    # off is a reload, not a re-render.
    Alias /unihelm-maintenance/ {{ maintenance_root }}/
    <Directory "{{ maintenance_root }}">
        Require all granted
    </Directory>
    ErrorDocument 503 /unihelm-maintenance/maintenance.html

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{REQUEST_URI} !^/unihelm-maintenance/
    RewriteRule ^ - [R=503,L]
{% else %}
{% if site.site_type == "redirect" %}
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ {{ site.redirect_target }}%{REQUEST_URI} [R={{ site.redirect_code }},L]
{% elif site.site_type == "proxy" %}
    ProxyPreserveHost On
    # Websockets: an upgrade request has to go over ws:// rather than through
    # ProxyPass, and it has to be matched before the catch-all below or the
    # handshake is answered by the HTTP proxy and fails.
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) ws://127.0.0.1:{{ site.proxy_port }}/$1 [P,L]

    ProxyPass        / http://127.0.0.1:{{ site.proxy_port }}/ timeout={{ site.proxy_timeout }}
    ProxyPassReverse / http://127.0.0.1:{{ site.proxy_port }}/
    RequestHeader set X-Forwarded-Proto "{% if site.tls_enabled %}https{% else %}http{% endif %}"
{% elif site.site_type == "php" %}
    <Directory "{{ site.document_root }}">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
        # The front controller, which is nginx's
        # `try_files $uri $uri/ /index.php?$query_string`. Apache keeps the
        # query string itself, so it is not repeated here.
        FallbackResource /index.php
    </Directory>

    # PATH_INFO off for the whole vhost. It is what makes Apache willing to
    # treat /uploads/avatar.png/evil.php as a request for evil.php with path
    # information attached, and turning it off is half of the protection below.
    AcceptPathInfo Off

    <FilesMatch "\.php$">
        # The single most important block in this file, and the counterpart of
        # nginx's `try_files $uri =404;` inside its `.php` location. Without it
        # a request for /uploads/avatar.png/evil.php is handed to PHP, and an
        # upload directory becomes remote code execution.
        #
        # `-f %{REQUEST_FILENAME}` is the same question `try_files` asks: is
        # there really a file here? If there is not, nothing reaches FPM.
        <If "! -f %{REQUEST_FILENAME}">
            Require all denied
        </If>
        SetHandler "proxy:unix:{{ site.fpm_socket }}|fcgi://localhost"
    </FilesMatch>

    <Proxy "unix:{{ site.fpm_socket }}|fcgi://localhost">
        ProxySet timeout={{ site.php_timeout }}
    </Proxy>
{% else %}
    <Directory "{{ site.document_root }}">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
{% endif %}
{% endif %}

{% if site.site_type == "php" or site.site_type == "static" %}
    # Static assets get a long cache; the site's own HTML does not.
    #
    # Only for sites that serve from disk, exactly as in the nginx template —
    # putting it on a proxy site would answer every css and js request from a
    # document root that holds none of them.
    <FilesMatch "\.(?:jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|css|js|mp4|webm)$">
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
        Header set Cache-Control "public, immutable"
    </FilesMatch>
{% endif %}

    # Dotfiles, version control and editor leftovers. `.well-known` is excluded
    # because ACME and security.txt live there. Two rules, not one: `<Files>`
    # catches a dotfile, `<DirectoryMatch>` catches everything under a dot
    # directory such as .git — which is the one that matters.
    <DirectoryMatch "/\.(?!well-known)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^\.(?!well-known)">
        Require all denied
    </FilesMatch>

    # Files that are commonly left in a webroot and should never be served.
    <FilesMatch "\.(?:sql|bak|old|orig|save|swp|log|env|ini|conf|sh|yml|yaml|lock)$">
        Require all denied
    </FilesMatch>
{% if site.custom_snippet %}

    # --- custom snippet -------------------------------------------------------
    # NOT APPLIED. This site has a snippet in the panel, and it is nginx
    # configuration: rendering it here would fail `apachectl configtest` and roll
    # the whole change back, and translating it would mean guessing at what it
    # was for. The panel says so on the site's page rather than leaving an
    # operator to find out from behaviour.
    # --- end custom snippet ---------------------------------------------------
{% endif %}
</VirtualHost>
