# The complete ModSecurity policy, generated by Ferrum (spec §11.9).
#
# Ferrum writes its own base configuration rather than including the
# `modsecurity.conf-recommended` that ships with libmodsecurity: that file is
# packaged inconsistently across distributions (different paths, different
# vintages, sometimes absent entirely), and a WAF whose base settings depend on
# which distribution packaged it is a WAF nobody can reason about. Every
# directive below is chosen here and rendered here.
#
# Order matters and is load-bearing:
#
#   1. base engine settings
#   2. the CRS setup file (defaults for the tx.* variables the rules read)
#   3. Ferrum's per-site policy — phase 1, so it runs before any CRS rule and
#      can still change the engine mode and the paranoia level for this
#      transaction
#   4. the CRS rules themselves
#   5. server-wide rule exclusions, which must come *after* the rules they
#      remove exist

# --- engine ----------------------------------------------------------------

# The server-wide default. `DetectionOnly` logs what would have been blocked
# and blocks nothing, which is the mode spec §11.9 asks a WAF to arrive in: a
# rule set that has never seen a site's real traffic will have false positives,
# and finding them in a log is cheaper than finding them in a support ticket.
# A site opts into blocking one at a time, below.
SecRuleEngine {{ default_engine }}

# Request bodies have to be buffered for the rules to see them at all. The
# limits are the CRS-recommended ones: 12.5 MB with files, 128 KB without.
SecRequestBodyAccess On
SecRequestBodyLimit 13107200
SecRequestBodyNoFilesLimit 131072
# Reject rather than ProcessPartial: a body truncated at the limit is a body
# the rules only partly inspected, and "partly inspected" is the shape an
# evasion takes.
SecRequestBodyLimitAction Reject

# Response body inspection stays off. It would buffer every response in memory
# to catch data leakage, and on a shared host with hundreds of sites that cost
# lands on every tenant to protect the few. The RESPONSE-95x CRS rules
# therefore do nothing here, which is a deliberate trade and not an oversight.
SecResponseBodyAccess Off

SecTmpDir {{ data_dir }}
SecDataDir {{ data_dir }}

# Audit only the transactions that matter: 5xx and 4xx-except-404. A 404 on a
# busy site is noise, and an audit log that fills the disk is a denial of
# service the panel inflicted on itself.
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "^(?:5|4(?!04))"
SecAuditLogParts ABIJDEFHZ
SecAuditLogType Serial
SecAuditLog {{ audit_log }}

SecArgumentSeparator &

# PCRE limits. Without a ceiling a crafted request can make a regex engine
# spend unbounded CPU, which turns the WAF into the attack.
SecPcreMatchLimit 100000
SecPcreMatchLimitRecursion 100000

# CRS requires the inspection phases to default to `pass`: the rules score a
# request and one final rule decides. A default of `deny` here would make every
# individual rule blocking and the scoring meaningless.
SecDefaultAction "phase:1,log,auditlog,pass"
SecDefaultAction "phase:2,log,auditlog,pass"

# --- OWASP Core Rule Set {{ crs_version }} -----------------------------------

Include {{ crs_dir }}/crs-setup.conf

# --- per-site policy (generated from the panel database) ---------------------
#
# One rule per site, matched on the Host header rather than on `SERVER_NAME`.
# Both carry the same value under the nginx connector, but `REQUEST_HEADERS:Host`
# says so out loud: the client chooses this value, exactly as it chooses which
# `server_name` block nginx routes it to, so the WAF's per-site policy and
# nginx's own vhost selection agree by construction.
#
# A request with no Host header, or with one matching no site, matches no rule
# here and is governed by the server-wide `SecRuleEngine` above. That is the
# safe direction: unknown traffic gets the default, never a site's relaxations.
#
# Rule ids come from the {{ rule_id_base }} block, inside the 1–99,999 range the
# Core Rule Set reserves for local rules, and are derived from the site id so an
# audit log entry naming a rule id names one site.
{% for site in sites %}
# {{ site.domain }} — {{ site.description }}
SecRule REQUEST_HEADERS:Host "@rx {{ site.host_pattern }}" \
    "id:{{ site.rule_id }},phase:1,nolog,pass,t:none,t:lowercase,{{ site.actions }}"
{% endfor %}
{% if sites | length == 0 %}
# (no site has a WAF policy of its own; every site runs the server-wide default)
{% endif %}

Include {{ crs_dir }}/rules/*.conf

# --- server-wide exclusions --------------------------------------------------
#
# After the includes, because `SecRuleRemoveById` can only remove a rule that
# has already been defined. Per-site exclusions are not here: they are
# `ctl:ruleRemoveById` actions on the site's own rule above, which is what
# scopes them to that site's traffic.
{% for exclusion in global_exclusions %}
# {{ exclusion.reason }}
SecRuleRemoveById {{ exclusion.rule_id }}
{% endfor %}
{% if global_exclusions | length == 0 %}
# (none)
{% endif %}
